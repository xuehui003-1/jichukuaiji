{
  "name": "accounting-ai-teaching",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:a": "npm run dev -w life-ledger",
    "dev:b": "npm run dev -w payment-simulator",
    "build": "npm run build -w life-ledger && npm run build -w payment-simulator && npm run build -w ai-finance-hub",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:setup": "npm run db:generate && prisma db push --force-reset && npm run db:seed",
    "postinstall": "prisma generate",
    "serve:a": "npm run start -w life-ledger",
    "serve:b": "npm run start -w payment-simulator",
    "audit:ui": "node scripts/audit-ui.mjs",
    "check:release": "node scripts/release-check.mjs",
    "dev:hub": "npm run dev -w ai-finance-hub",
    "serve:hub": "npm run start -w ai-finance-hub"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "prisma": "6.19.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@prisma/client": "6.19.3",
    "three": "^0.180.0"
  }
}
